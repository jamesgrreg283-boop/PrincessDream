# Copy to `.env.local` for local development (gitignored).
# Never commit real keys.

# Stripe Checkout (server creates session — see `api/create-checkout-session.mjs`)
# After deploying to Vercel, use your production/preview URL:
# VITE_STRIPE_CHECKOUT_ENDPOINT=https://your-project.vercel.app/api/create-checkout-session
# With `npx vercel dev`, use the URL the CLI prints, e.g.:
# VITE_STRIPE_CHECKOUT_ENDPOINT=http://localhost:3000/api/create-checkout-session
VITE_STRIPE_CHECKOUT_ENDPOINT=

# Optional — for future Stripe.js / Elements only (not required for Checkout redirect)
VITE_STRIPE_PUBLISHABLE_KEY=

# Used only when running `vercel dev` locally (same file can hold these; Vercel
# Dashboard holds them in production):
# STRIPE_SECRET_KEY=
# STRIPE_ALLOWED_FRONTEND_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Stripe catalogue Price IDs (run `npm run stripe:sync-deposits` once, then paste here + Vercel):
# STRIPE_PRICE_30_MINUTE_APPEARANCE=price_...
# STRIPE_PRICE_1_HOUR_PARTY=price_...
# STRIPE_PRICE_2_HOUR_PARTY=price_...
