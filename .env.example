# Copy to .env.local for local scripts; set the same keys in Vercel Project → Settings → Environment Variables.

# Stripe (https://dashboard.stripe.com/apikeys)
# Must be the standard Secret key: sk_test_… or sk_live_… (not pk_, rk_, or other keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: fixed Price IDs from `npm run stripe:sync-deposits`
# Create a separate £1 test product + price (leaves your £40 catalogue alone):
#   npm run stripe:create-30min-1gbp-deposit
# For £1 test checkouts on the 30-min package, leave STRIPE_PRICE_30_MINUTE_APPEARANCE unset
# (Checkout uses automatic £1) OR set it to a Stripe Price that is exactly £1 (100 pence).
# Do not set it to your £40 catalogue Price while the site expects £1.
# STRIPE_PRICE_30_MINUTE_APPEARANCE=
# STRIPE_PRICE_1_HOUR_PARTY=
# STRIPE_PRICE_2_HOUR_PARTY=

# Optional comma-separated *extra* allowed origins (e.g. staging). HTTPS production sites are
# already allowed; this does not lock the site to only these URLs. See api/_lib/cors.mjs.
# STRIPE_ALLOWED_FRONTEND_ORIGINS=https://staging.example.com

# Direct Postgres URL (optional if you use SUPABASE_URL + SUPABASE_DB_PASSWORD instead)
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# For `npm run db:apply-bookings` without DATABASE_URL: database password from
# Supabase → Project Settings → Database (not the anon/service API keys)
# SUPABASE_DB_PASSWORD=

# Supabase (Project Settings → API) — service role only on the server, never in Vite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com/api-keys)
# Required on Vercel for production booking emails (.env.local is NOT used on deploy).
RESEND_API_KEY=
# Must be a verified sender/domain in Resend (e.g. Bookings <bookings@yourdomain.com>)
RESEND_FROM_EMAIL=

# Inbox for new confirmed booking notifications (Resend)
ADMIN_BOOKING_EMAIL=princessdreamuk@gmail.com

# Public https origin (no trailing slash) where /email/princessdream-logo.png is served for customer booking emails.
# Defaults to Vercel preview URL, then https://aprincessdream.co.uk — set explicitly if your live domain differs (e.g. www).
# BOOKING_EMAIL_ASSETS_BASE_URL=https://www.princessdream.co.uk

# Optional: shown in booking email footers (defaults match src/data/site.ts)
# BOOKING_SUPPORT_PHONE=07871 796024
# BOOKING_SUPPORT_PHONE_TEL=+447871796024

# Legacy fallback if ADMIN_BOOKING_EMAIL is unset (optional)
# NOTIFY_EMAIL_TO=princessdreamuk@gmail.com

# Admin area (/admin/bookings) — long random password; HTTP-only cookie session
ADMIN_PASSWORD=

# Travel buffer (minutes) after one party ends before another can start the same day (default 60).
# BOOKING_TRAVEL_BUFFER_MINUTES=60

# How long an unpaid Stripe checkout keeps the slot (default 15). Also cleared when the customer
# returns via Stripe’s cancel link (`/book?canceled=1&session_id=…`).
# BOOKING_PENDING_HOLD_MINUTES=15
